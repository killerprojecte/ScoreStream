{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScoreStream UI acceptance repair",
  "version": "0.1.0",
  "identifier": "io.scorestream.shadcn-native-repair",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../desktop"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../desktop"
    },
    "frontendDist": "../../desktop/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A Rust-backed score editor",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
