<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic timing regression, not a complete or sanitized Beethoven score. -->
<score-partwise version="4.0">
  <part-list><score-part id="p"><part-name>piano</part-name><score-instrument id="i"><instrument-name>piano</instrument-name></score-instrument></score-part></part-list>
  <part id="p">
    <measure id="pickup" number="0" implicit="yes">
      <attributes><divisions>4</divisions><time><beats>4</beats><beat-type>4</beat-type></time></attributes>
      <sound tempo="120"/>
      <note id="pickup_note"><pitch><step>C</step><octave>4</octave></pitch><duration>4</duration><voice>1</voice></note>
    </measure>
    <measure id="main" number="1">
      <direction><direction-type><metronome><beat-unit>half</beat-unit><beat-unit-dot/><per-minute>96</per-minute></metronome></direction-type><offset>4</offset><sound tempo="288"/></direction>
      <note id="held"><pitch><step>C</step><octave>4</octave></pitch><duration>8</duration><voice>1</voice></note>
      <sound tempo="120"><offset>-2</offset></sound>
      <note id="rest"><rest/><duration>8</duration><voice>1</voice></note>
    </measure>
  </part>
</score-partwise>
