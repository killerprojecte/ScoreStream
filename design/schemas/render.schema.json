{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scorestream:schema:render:1.1",
  "title": "ScoreStream revision-specific rendering contract 1.1",
  "$ref": "#/$defs/RenderResult",
  "$defs": {
    "Coverage": {
      "type": "object",
      "properties": {
        "interpreted_features": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "maxItems": 256
        },
        "preserved_only_features": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "maxItems": 256
        },
        "unsupported_features": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "maxItems": 256
        },
        "complete": {
          "type": "boolean"
        },
        "details_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^scorestream://",
          "maxLength": 2048
        }
      },
      "required": [
        "interpreted_features",
        "preserved_only_features",
        "unsupported_features",
        "complete"
      ],
      "additionalProperties": false,
      "description": "Capability observations for this operation and revision, not a claim of universal MusicXML completeness. complete describes this bounded report, not total semantic coverage."
    },
    "LayoutOptions": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "page"
          ],
          "default": "page"
        },
        "page_width_mm": {
          "type": "number",
          "minimum": 50,
          "maximum": 1000,
          "default": 210
        },
        "page_height_mm": {
          "type": "number",
          "minimum": 50,
          "maximum": 1000,
          "default": 297
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Physical page dimensions. They are translated by the backend; returned SVG viewBox coordinates are a separate space. A UI zoom is not a score edit."
    },
    "RenderRequest": {
      "type": "object",
      "properties": {
        "score_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/Id"
        },
        "revision_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/RevisionId"
        },
        "selection": {
          "$ref": "urn:scorestream:schema:selection:1.1#/$defs/FrozenSelectionRef"
        },
        "layout": {
          "$ref": "urn:scorestream:schema:render:1.1#/$defs/LayoutOptions"
        }
      },
      "required": [
        "score_id",
        "revision_id"
      ],
      "additionalProperties": false,
      "description": "Requires a configured available backend. Optional selection must name this same score revision. Whole score is the default scope."
    },
    "Page": {
      "type": "object",
      "properties": {
        "page_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/Id"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "svg_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^scorestream://",
          "maxLength": 2048
        },
        "mapping_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^scorestream://",
          "maxLength": 2048
        },
        "coordinate_space": {
          "const": "page_viewbox"
        },
        "view_box": {
          "$ref": "urn:scorestream:schema:selection:1.1#/$defs/PageRectangle"
        }
      },
      "required": [
        "page_id",
        "page_number",
        "svg_uri",
        "mapping_uri",
        "coordinate_space",
        "view_box"
      ],
      "additionalProperties": false,
      "description": "Page numbering is presentation; page_id is scoped to render_id. The SVG and mapping are published together."
    },
    "RenderResult": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "render"
        },
        "render_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/Id"
        },
        "score_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/Id"
        },
        "revision_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/RevisionId"
        },
        "options_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "renderer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "maxLength": 100
            },
            "projection_version": {
              "type": "string",
              "maxLength": 100
            },
            "font_set_id": {
              "type": "string",
              "maxLength": 160
            }
          },
          "required": [
            "name",
            "version",
            "projection_version",
            "font_set_id"
          ],
          "additionalProperties": false
        },
        "manifest_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^scorestream://",
          "maxLength": 2048
        },
        "total_pages": {
          "type": "integer",
          "minimum": 1
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "urn:scorestream:schema:render:1.1#/$defs/Page"
          },
          "maxItems": 256,
          "minItems": 1
        },
        "pages_complete": {
          "type": "boolean"
        },
        "pages_continuation_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^scorestream://",
          "maxLength": 2048
        },
        "coverage": {
          "$ref": "urn:scorestream:schema:render:1.1#/$defs/Coverage"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "urn:scorestream:schema:common:1.1#/$defs/Diagnostic"
          },
          "maxItems": 100
        }
      },
      "required": [
        "kind",
        "render_id",
        "score_id",
        "revision_id",
        "options_hash",
        "renderer",
        "manifest_uri",
        "total_pages",
        "pages",
        "pages_complete",
        "coverage",
        "diagnostics"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pages_complete": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "pages_continuation_uri"
            ]
          },
          "else": {
            "not": {
              "required": [
                "pages_continuation_uri"
              ]
            }
          }
        }
      ],
      "description": "A derived immutable result for an exact score revision. Further immutable page-index resources bound a large result; stale UI views must not publish this result as another revision."
    },
    "MappedObject": {
      "type": "object",
      "properties": {
        "svg_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "object_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:scorestream:schema:common:1.1#/$defs/Id"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "object_kind": {
          "type": "string",
          "enum": [
            "event",
            "measure",
            "relation",
            "mark",
            "layout_only"
          ]
        },
        "bounds": {
          "type": "array",
          "items": {
            "$ref": "urn:scorestream:schema:selection:1.1#/$defs/PageRectangle"
          },
          "maxItems": 64
        },
        "editable": {
          "type": "boolean"
        }
      },
      "required": [
        "svg_id",
        "object_ids",
        "object_kind",
        "bounds",
        "editable"
      ],
      "additionalProperties": false,
      "description": "Mapping is not assumed one-to-one. Layout-only objects may have no musical object IDs. Visibility does not grant edit authority."
    },
    "PageMapping": {
      "type": "object",
      "properties": {
        "render_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/Id"
        },
        "score_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/Id"
        },
        "revision_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/RevisionId"
        },
        "page_id": {
          "$ref": "urn:scorestream:schema:common:1.1#/$defs/Id"
        },
        "coordinate_space": {
          "const": "page_viewbox"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "urn:scorestream:schema:render:1.1#/$defs/MappedObject"
          },
          "maxItems": 10000
        },
        "complete": {
          "type": "boolean"
        },
        "continuation_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^scorestream://",
          "maxLength": 2048
        }
      },
      "required": [
        "render_id",
        "score_id",
        "revision_id",
        "page_id",
        "coordinate_space",
        "objects",
        "complete"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "continuation_uri"
            ]
          }
        }
      ]
    }
  }
}
