{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scorestream:schema:ast:1.1",
  "title": "ScoreStream 1.1 parsed core AST",
  "description": "Validates parsed structure, not the raw SFS text. A semantic validator is still required.",
  "type": "object",
  "properties": {
    "format": {
      "const": "ScoreStream"
    },
    "format_version": {
      "const": "1.1"
    },
    "document_kind": {
      "enum": [
        "score",
        "fragment"
      ]
    },
    "time_unit": {
      "const": "quarter"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Part"
      }
    },
    "voices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Voice"
      }
    },
    "metadata": {
      "$ref": "#/$defs/DocumentMetadata"
    },
    "required_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Frame"
      }
    },
    "end": {
      "$ref": "#/$defs/NonNegativeRational"
    },
    "span": {
      "$ref": "#/$defs/PositiveRational"
    }
  },
  "required": [
    "format",
    "format_version",
    "document_kind",
    "time_unit",
    "parts",
    "voices",
    "metadata",
    "required_extensions",
    "frames",
    "end"
  ],
  "additionalProperties": false,
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "Rational": {
      "type": "string",
      "description": "Canonical reduced rational string. Reduction is checked semantically.",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
    },
    "PositiveRational": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:/[1-9][0-9]*)?$"
    },
    "NonNegativeRational": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
    },
    "Pitch": {
      "type": "string",
      "pattern": "^[A-G](?:#{1,2}|b{1,2}|\\([+-]?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?\\))?-?(?:0|[1-9][0-9]*)$"
    },
    "Scope": {
      "type": "string",
      "pattern": "^(?:score|[A-Za-z][A-Za-z0-9_-]*(?:\\.s[1-9][0-9]*)?)$"
    },
    "Reference": {
      "type": "string",
      "pattern": "^#[A-Za-z][A-Za-z0-9_-]*$"
    },
    "Scalar": {
      "type": [
        "string",
        "integer",
        "boolean"
      ]
    },
    "Attributes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Scalar"
      },
      "description": "Flat values. The language registry checks names, types, scopes and extension requirements. Unknown unqualified fields fail semantic validation."
    },
    "DocumentMetadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "description": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "header": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "footer": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "subtitle": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "composer": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "lyricist": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "arranger": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "work_number": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "movement": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "rights": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "language": {
          "type": "string",
          "description": "Plain score text, never markup or a filename fallback. Optional; an empty string is explicit empty text."
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*$"
              }
            ]
          },
          "description": "Ordered plain author names. Empty or absent means no generic author list; legacy role fields remain separate."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Part": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "staves": {
          "type": "integer",
          "minimum": 1
        },
        "display_name": {
          "type": "string",
          "description": "Optional plain authored part label, independent of instrument identity. Absence uses the instrument as a renderer fallback; an empty string is an explicitly empty label. Text must contain only XML 1.0 characters."
        }
      },
      "required": [
        "id",
        "instrument",
        "staves"
      ],
      "additionalProperties": false
    },
    "Voice": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "part": {
          "$ref": "#/$defs/Identifier"
        },
        "staff": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "part",
        "staff"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "record": {
          "const": "event"
        },
        "voice": {
          "$ref": "#/$defs/Identifier"
        },
        "pitch": {
          "oneOf": [
            {
              "$ref": "#/$defs/Pitch"
            },
            {
              "enum": [
                "r",
                "_"
              ]
            },
            {
              "type": "string",
              "pattern": "^u\\.[A-Za-z][A-Za-z0-9_-]*$"
            }
          ]
        },
        "duration": {
          "oneOf": [
            {
              "$ref": "#/$defs/PositiveRational"
            },
            {
              "const": "?"
            }
          ]
        },
        "attributes": {
          "$ref": "#/$defs/Attributes"
        }
      },
      "required": [
        "record",
        "voice",
        "pitch",
        "duration",
        "attributes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "duration": {
                "const": "?"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "required": [
                  "kind",
                  "anchor",
                  "order"
                ],
                "properties": {
                  "kind": {
                    "const": "grace"
                  },
                  "anchor": {
                    "$ref": "#/$defs/Reference"
                  },
                  "order": {
                    "type": "integer",
                    "not": {
                      "const": 0
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "State": {
      "type": "object",
      "properties": {
        "record": {
          "const": "state"
        },
        "target": {
          "$ref": "#/$defs/Scope"
        },
        "attributes": {
          "$ref": "#/$defs/Attributes"
        }
      },
      "required": [
        "record",
        "target",
        "attributes"
      ],
      "additionalProperties": false
    },
    "Mark": {
      "type": "object",
      "properties": {
        "record": {
          "const": "mark"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/Scope"
            },
            {
              "$ref": "#/$defs/Reference"
            }
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "$ref": "#/$defs/Attributes"
        }
      },
      "required": [
        "record",
        "target",
        "kind",
        "attributes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scorestream.barline"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/Identifier"
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "measure": {
                    "$ref": "#/$defs/Identifier"
                  },
                  "side": {
                    "enum": [
                      "left",
                      "right"
                    ]
                  },
                  "style": {
                    "enum": [
                      "regular",
                      "dotted",
                      "dashed",
                      "heavy",
                      "light-light",
                      "light-heavy",
                      "heavy-light",
                      "heavy-heavy",
                      "tick",
                      "short",
                      "none"
                    ]
                  },
                  "repeat": {
                    "enum": [
                      "forward",
                      "backward"
                    ]
                  },
                  "times": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "ending": {
                    "enum": [
                      "start",
                      "stop",
                      "discontinue"
                    ]
                  },
                  "passes": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384,
                    "pattern": "^[1-9][0-9]*(?:,[1-9][0-9]*)*$"
                  },
                  "ending_text": {
                    "type": "string"
                  },
                  "ending_y": {
                    "$ref": "#/$defs/Rational"
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "measure",
                  "side"
                ],
                "additionalProperties": false,
                "dependentRequired": {
                  "passes": [
                    "ending"
                  ],
                  "ending": [
                    "passes"
                  ],
                  "ending_text": [
                    "ending"
                  ],
                  "ending_y": [
                    "ending"
                  ],
                  "times": [
                    "repeat"
                  ]
                }
              }
            },
            "description": "Requires scorestream.navigation@1; exact ownership/time, field pairing and route restrictions are checked semantically."
          }
        }
      ]
    },
    "Relation": {
      "type": "object",
      "properties": {
        "record": {
          "const": "relation"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "phase": {
          "enum": [
            "start",
            "end",
            "continue"
          ]
        },
        "anchor": {
          "$ref": "#/$defs/Reference"
        },
        "attributes": {
          "$ref": "#/$defs/Attributes"
        }
      },
      "required": [
        "record",
        "kind",
        "id",
        "phase",
        "anchor",
        "attributes"
      ],
      "additionalProperties": false
    },
    "Measure": {
      "type": "object",
      "properties": {
        "record": {
          "const": "measure"
        },
        "target": {
          "$ref": "#/$defs/Scope"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "length": {
          "$ref": "#/$defs/PositiveRational"
        },
        "attributes": {
          "$ref": "#/$defs/Attributes"
        }
      },
      "required": [
        "record",
        "target",
        "id",
        "length",
        "attributes"
      ],
      "additionalProperties": false
    },
    "Record": {
      "oneOf": [
        {
          "$ref": "#/$defs/Event"
        },
        {
          "$ref": "#/$defs/State"
        },
        {
          "$ref": "#/$defs/Mark"
        },
        {
          "$ref": "#/$defs/Relation"
        },
        {
          "$ref": "#/$defs/Measure"
        }
      ]
    },
    "Frame": {
      "type": "object",
      "properties": {
        "time": {
          "$ref": "#/$defs/NonNegativeRational"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Record"
          }
        }
      },
      "required": [
        "time",
        "records"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "document_kind": {
            "const": "fragment"
          }
        }
      },
      "then": {
        "required": [
          "span"
        ],
        "properties": {
          "parts": {
            "maxItems": 0
          },
          "voices": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "span"
          ]
        }
      }
    }
  ]
}
