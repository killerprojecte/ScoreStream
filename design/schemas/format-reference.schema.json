{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scorestream:schema:format-reference:1.1",
  "title": "Agent-facing ScoreStream language reference descriptor",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "profile",
    "records",
    "vocabulary",
    "semantic_rules",
    "examples",
    "validation_boundary",
    "mcp_resources"
  ],
  "properties": {
    "format": {
      "const": "ScoreStream"
    },
    "format_version": {
      "const": "1.1"
    },
    "profile": {
      "const": "core-measured"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string"
          },
          "syntax": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "required": [
          "prefix",
          "syntax",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "semantic_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{3}$"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "rule"
        ],
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "file",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "vocabulary": {
      "type": "object"
    },
    "validation_boundary": {
      "type": "string"
    },
    "mcp_resources": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
