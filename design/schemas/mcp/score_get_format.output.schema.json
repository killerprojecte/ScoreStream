{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scorestream:tool:score_get_format:output:1.1",
  "title": "Get the ScoreStream language standard application result",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/mcp_contract__FormatData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/job__DomainError"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Exactly one application success or error branch. Protocol resultType/content/structuredContent/isError wrap this object; they are not fields inside it.",
  "$defs": {
    "common__Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "object_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common__Id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ],
      "additionalProperties": false
    },
    "common__Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Opaque stable external identifier. A displayed measure number, staff number, or event ordinal is not an identifier. External IDs are not automatically legal SFS aliases: use the returned alias/reference map and TextIdentifier for fragment-local names.",
      "not": {
        "pattern": "\\s"
      }
    },
    "common__RevisionId": {
      "allOf": [
        {
          "$ref": "#/$defs/common__Id"
        }
      ],
      "description": "Immutable score revision identifier; never the mutable alias latest."
    },
    "format_reference__Root": {
      "title": "Agent-facing ScoreStream language reference descriptor",
      "type": "object",
      "required": [
        "format",
        "format_version",
        "profile",
        "records",
        "vocabulary",
        "semantic_rules",
        "examples",
        "validation_boundary",
        "mcp_resources"
      ],
      "properties": {
        "format": {
          "const": "ScoreStream"
        },
        "format_version": {
          "const": "1.1"
        },
        "profile": {
          "const": "core-measured"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string"
              },
              "syntax": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            },
            "required": [
              "prefix",
              "syntax",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "semantic_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]{3}$"
              },
              "rule": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "rule"
            ],
            "additionalProperties": false
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "file",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "vocabulary": {
          "type": "object"
        },
        "validation_boundary": {
          "type": "string"
        },
        "mcp_resources": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "job__DomainError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common__Diagnostic"
          },
          "maxItems": 100
        },
        "score_id": {
          "$ref": "#/$defs/common__Id"
        },
        "expected_revision_id": {
          "$ref": "#/$defs/common__RevisionId"
        },
        "current_revision_id": {
          "$ref": "#/$defs/common__RevisionId"
        },
        "details_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^scorestream://",
          "maxLength": 2048
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "diagnostics"
      ],
      "additionalProperties": false,
      "description": "An actionable application error, not a JSON-RPC error code. Diagnostics are bounded; additional details may be a resource."
    },
    "mcp_contract__FormatData": {
      "anyOf": [
        {
          "$ref": "#/$defs/mcp_contract__QuickReference"
        },
        {
          "$ref": "#/$defs/format_reference__Root"
        }
      ]
    },
    "mcp_contract__QuickReference": {
      "title": "Quick authoring reference returned by default",
      "type": "object",
      "required": [
        "format",
        "format_version",
        "profile",
        "records",
        "semantic_rules",
        "examples",
        "validation_boundary",
        "mcp_resources",
        "common_attributes",
        "core_shape",
        "pitch",
        "time"
      ],
      "properties": {
        "format": {
          "const": "ScoreStream"
        },
        "format_version": {
          "const": "1.1"
        },
        "profile": {
          "const": "core-measured"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string"
              },
              "syntax": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            },
            "required": [
              "prefix",
              "syntax",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "semantic_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]{3}$"
              },
              "rule": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "rule"
            ],
            "additionalProperties": false
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "file",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "vocabulary": {
          "type": "object"
        },
        "validation_boundary": {
          "type": "string"
        },
        "mcp_resources": {
          "type": "object"
        },
        "common_attributes": {
          "type": "object"
        },
        "core_shape": {
          "type": "string",
          "minLength": 1
        },
        "pitch": {
          "type": "object"
        },
        "time": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
