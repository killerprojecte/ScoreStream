{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scorestream:tool:score_preview_edit:output:1.1",
  "title": "Preview typed score edits application result",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/mcp_contract__PreviewResult"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/job__DomainError"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Exactly one application success or error branch. Protocol resultType/content/structuredContent/isError wrap this object; they are not fields inside it.",
  "$defs": {
    "common__Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "object_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common__Id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ],
      "additionalProperties": false
    },
    "common__Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Opaque stable external identifier. A displayed measure number, staff number, or event ordinal is not an identifier. External IDs are not automatically legal SFS aliases: use the returned alias/reference map and TextIdentifier for fragment-local names.",
      "not": {
        "pattern": "\\s"
      }
    },
    "common__RevisionId": {
      "allOf": [
        {
          "$ref": "#/$defs/common__Id"
        }
      ],
      "description": "Immutable score revision identifier; never the mutable alias latest."
    },
    "job__DomainError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common__Diagnostic"
          },
          "maxItems": 100
        },
        "score_id": {
          "$ref": "#/$defs/common__Id"
        },
        "expected_revision_id": {
          "$ref": "#/$defs/common__RevisionId"
        },
        "current_revision_id": {
          "$ref": "#/$defs/common__RevisionId"
        },
        "details_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^scorestream://",
          "maxLength": 2048
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "diagnostics"
      ],
      "additionalProperties": false,
      "description": "An actionable application error, not a JSON-RPC error code. Diagnostics are bounded; additional details may be a resource."
    },
    "mcp_contract__PreviewResult": {
      "type": "object",
      "properties": {
        "status": {
          "const": "preview"
        },
        "score_id": {
          "$ref": "#/$defs/common__Id"
        },
        "expected_revision_id": {
          "$ref": "#/$defs/common__RevisionId"
        },
        "would_commit": {
          "const": true
        },
        "changed_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common__Id"
          },
          "maxItems": 4096,
          "uniqueItems": true
        },
        "deleted_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common__Id"
          },
          "maxItems": 4096,
          "uniqueItems": true
        },
        "planned_insertions": {
          "type": "integer",
          "minimum": 0
        },
        "affected_relation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common__Id"
          },
          "maxItems": 4096,
          "uniqueItems": true
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common__Diagnostic"
          },
          "maxItems": 100
        }
      },
      "required": [
        "status",
        "score_id",
        "expected_revision_id",
        "would_commit",
        "changed_ids",
        "deleted_ids",
        "planned_insertions",
        "affected_relation_ids",
        "diagnostics"
      ],
      "additionalProperties": false,
      "description": "A pure validation/diff preview; no artifact or durable job is created by this MVP tool. It neither reserves new IDs nor changes head. Rendering a draft is a desktop application function."
    }
  }
}
