{
  "name": "scorestream-desktop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:pcm": "node --experimental-strip-types --test tests/pcm-encoding.mjs",
    "test:audio-render": "node tests/render-audio.mjs",
    "tauri": "tauri",
    "desktop:dev": "cd ../crates/scorestream-desktop && tauri dev",
    "desktop:build": "cd ../crates/scorestream-desktop && tauri build",
    "dev:smoke": "vite --mode smoke --host 127.0.0.1",
    "build:smoke": "tsc --noEmit && vite build --mode smoke"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tauri-apps/api": "2.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.55.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.22.1",
    "tailwind-merge": "2.6.0",
    "verovio": "5.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.9.4",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "jsdom": "27.4.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
